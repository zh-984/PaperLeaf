{
  "name": "paperleaf",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "postinstall": "prisma generate && node scripts/setup.mjs",
    "db:deploy": "node scripts/setup.mjs && prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:restart": "node tests/restart-check.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:pack": "pnpm desktop:prepare && node scripts/build-desktop.mjs --dir",
    "desktop:build": "pnpm desktop:prepare && node scripts/build-desktop.mjs",
    "test:desktop": "node tests/desktop-smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "busboy": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.4.3",
    "jsdom": "^28.1.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "prisma": "6.19.3",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
