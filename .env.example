# Relative DATABASE_URL paths resolve from prisma/schema.prisma.
DATABASE_URL="file:../data/library.db"
NEXT_TELEMETRY_DISABLED="1"
# Build output directory; leave unchanged outside isolated tests.
NEXT_DIST_DIR=".next"
# NEXT_TEST_TSCONFIG is set only by the isolated browser-test harness.
# PAPERLEAF_DESKTOP_BUILD=1 is set by desktop:prepare for standalone output.
# PAPERLEAF_DESKTOP=1, PAPERLEAF_PROFILE and PAPERLEAF_SERVER_ROOT are set by the desktop launcher.
# PAPERLEAF_DESKTOP_TEST / PAPERLEAF_TEST_PROFILE / DESKTOP_EXECUTABLE are used only by desktop tests.
DATA_DIR="./data"
MAX_UPLOAD_MB="50"
MAX_UPLOAD_FILES="10"
AI_ENABLED="false"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="120000"
AI_MAX_INPUT_CHARS="14000"
AI_MAX_OUTPUT_TOKENS="3000"
AI_CHUNK_CHARS="10000"
